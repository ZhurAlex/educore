# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Compiled esbuild output (React) — rebuilt via `npm run build`.
/app/assets/builds/*
!/app/assets/builds/.keep

# Node dependencies.
/node_modules

# Ignore SimpleCov coverage reports.
/coverage

# Ignore master key for decrypting credentials and more.
/config/master.key

# Editor-specific settings (see the note at the top of this file — a global
# gitignore is arguably the more correct place for this, but this is simpler).
/.vscode
/notes.txt
