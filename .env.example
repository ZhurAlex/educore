POSTGRES_USER=educore
POSTGRES_PASSWORD=educore
POSTGRES_DB=educore_development

DATABASE_HOST=localhost
DATABASE_PORT=5432

REDIS_PORT=6379

# Grades long_text answers — see README's Setup section. Without it,
# long_text submissions still complete, just flagged manual_check_required.
GEMINI_API_KEY=replace-with-your-own-gemini-key

# Shared secret for the educore-analytics API (docs/API_CONTRACT.md) — must
# be the same value in both projects' .env. Generate a real one, e.g.
# `bin/rails secret` — never ship this placeholder as a real credential.
ANALYTICS_API_KEY=replace-with-a-generated-secret

BROWSER=flatpak run com.google.Chrome