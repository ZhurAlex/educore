<%# Only :database_authenticatable, :recoverable, :rememberable, :validatable
    are enabled (see Teacher model) — the registerable/confirmable/lockable
    branches Devise's generator normally includes here are unreachable. %>
<%- if controller_name != 'sessions' %>
  <p><%= link_to "Log in", new_session_path(resource_name) %></p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' %>
  <p><%= link_to "Forgot your password?", new_password_path(resource_name) %></p>
<% end %>
