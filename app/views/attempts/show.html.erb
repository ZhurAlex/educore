<h1><%= @attempt.student.full_name %></h1>
<p><%= @attempt.test.title %> — <%= t("attempts.index.status") %>: <%= @attempt.status %></p>
<p><%= t("attempts.index.score") %>: <%= @attempt.score %> — <%= t("attempts.index.grade") %>: <%= @attempt.grade %></p>

<table>
  <thead>
    <tr>
      <th><%= t(".question") %></th>
      <th><%= t(".answer") %></th>
      <th><%= t(".correct_answer") %></th>
      <th><%= t(".points") %></th>
      <th><%= t(".grading_status_label") %></th>
      <th><%= t(".feedback") %></th>
      <th><%= t(".override") %></th>
    </tr>
  </thead>
  <tbody>
    <% @responses.each do |response| %>
      <% question = response.question %>
      <tr class="<%= "needs-review" if response.manual_check_required? %>">
        <td><%= question.body %></td>
        <td>
          <%= question.multiple_choice? ? response.option&.body : response.answer_text %>
        </td>
        <td>
          <%= question.multiple_choice? ? question.options.find(&:correct?)&.body : question.correct_answer %>
        </td>
        <td>
          <%= response.points_awarded %> / <%= question.points %>
          <% if response.teacher_overridden? %>
            <span class="badge"><%= t(".teacher_overridden") %></span>
          <% end %>
        </td>
        <td><%= t(".#{response.grading_status}") %></td>
        <td><%= response.feedback %></td>
        <td>
          <%= form_with model: response, url: response_path(response), method: :patch do |form| %>
            <div class="field">
              <%= form.label :points_awarded, t(".points") %>
              <%= form.number_field :points_awarded, step: 0.5, min: 0 %>
            </div>
            <div class="field">
              <%= form.label :feedback, t(".feedback") %>
              <%= form.text_area :feedback, rows: 2 %>
            </div>
            <%= form.submit t(".save") %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
