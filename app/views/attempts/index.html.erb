<h1><%= t(".title", test_title: @test.title) %></h1>

<% @attempts_by_class.each do |class_name, attempts| %>
  <details>
    <summary class="class-name"><%= class_name %></summary>
    <table>
      <thead>
        <tr>
          <th><%= Student.human_attribute_name(:first_name) %></th>
          <th><%= t(".status") %></th>
          <th><%= t(".score") %></th>
          <th><%= t(".grade") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% attempts.each do |attempt| %>
          <tr>
            <td><%= attempt.student.full_name %></td>
            <td><%= attempt.status %></td>
            <td><%= attempt.score %></td>
            <td><%= attempt.grade %></td>
            <td><%= link_to t(".view"), attempt_path(attempt) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </details>
<% end %>
