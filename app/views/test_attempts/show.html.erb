<h1><%= @test_attempt.test.title %></h1>

<% if @test_attempt.in_progress? %>
  <%= form_with model: @test_attempt do |form| %>
    <% @questions.each do |question| %>
      <fieldset>
        <legend><%= question.body %> (<%= question.points %> pts)</legend>

        <% if question.multiple_choice? %>
          <% question.options.each do |option| %>
            <div>
              <%= radio_button_tag "answers[#{question.id}][option_id]", option.id %>
              <%= label_tag "answers_#{question.id}_option_id_#{option.id}", option.body %>
            </div>
          <% end %>
        <% else %>
          <%= text_field_tag "answers[#{question.id}][answer_text]" %>
        <% end %>
      </fieldset>
    <% end %>

    <%= form.submit t(".submit") %>
  <% end %>
<% else %>
  <div class="results-card">
    <p class="results-headline"><%= t(".completed_headline") %></p>
    <p class="results-score">
      <span><%= t("attempts.index.score") %>: <strong><%= @test_attempt.score %></strong></span>
      <span><%= t("attempts.index.grade") %>: <strong><%= @test_attempt.grade %></strong></span>
    </p>
    <p class="results-note"><%= t(".completed_note") %></p>
  </div>
<% end %>
