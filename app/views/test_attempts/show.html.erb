<h1><%= @test_attempt.test.title %></h1>
<% if @test_attempt.in_progress? %>
  <div id="test-attempt-react-root" data-questions="<%= questions_as_json(@questions)%>"></div>
<% else %>
  <div class="results-card">
    <p class="results-headline"><%= t(".completed_headline") %></p>
    <p class="results-score">
      <span><%= t("attempts.index.score") %>: <strong><%= @test_attempt.score %></strong></span>
      <span><%= t("attempts.index.grade") %>: <strong><%= @test_attempt.grade %></strong></span>
    </p>
    <p class="results-note"><%= t(".completed_note") %></p>
  </div>
<% end %>
<%= javascript_include_tag "test_attempt" %>
