<%= form_with model: test do |form| %>
  <% if test.errors.any? %>
    <ul>
      <% test.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :subject %>
    <%= form.select :subject, Test.subjects.keys %>
  </div>

  <div>
    <%= form.label :locale %>
    <%= form.select :locale, Test::LOCALES %>
  </div>

  <%= form.submit %>
<% end %>
