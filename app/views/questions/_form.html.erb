<%= form_with model: question, url: url, data: { controller: "question" } do |form| %>
  <% if question.errors.any? %>
    <ul>
      <% question.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :body %>
    <%= form.text_area :body %>
  </div>

  <div>
    <%= form.label :answer_type %>
    <%= form.select :answer_type, Question.answer_types.keys, {}, data: { action: "question#showFields", question_target: "answerTypes" } %>
  </div>

  <div>
    <%= form.label :points %>
    <%= form.number_field :points, step: 0.5, min: 0.5 %>
  </div>

  <div data-question-target="correctAnswer">
    <%= form.label :correct_answer %>
    <%= form.text_field :correct_answer %>
  </div>

  <fieldset data-question-target="optionsContainer">
    <legend><%= t("questions.form.options_legend") %></legend>
      <div data-question-target="optionsList">
        <%= form.fields_for :options do |option_form| %>
          <div>
            <%= render "option_item", option_form: option_form %>
          </div>
        <% end %>
      </div>
      <%# This is a template for adding new options for Stimulus %>
      <template data-question-target="template">
        <div>
          <%= form.fields_for :options, Option.new, child_index: "NEW_RECORD" do |option_form| %>
            <%= render "option_item", option_form: option_form %>
          <% end %>
        </div>
      </template>
    <button type="button" data-action="question#addOption"><%= t("questions.form.add_option") %></button>
  </fieldset>

  <%= form.submit %>
<% end %>
