<h1><%= t(".title") %></h1>

<section>
  <h2><%= t(".school_classes") %></h2>
  <ul>
    <% @school_classes.each do |school_class| %>
      <li><%= link_to school_class.name, school_class_path(school_class) %> (<%= t(".students_count", count: school_class.students.count) %>)</li>
    <% end %>
  </ul>
  <%= link_to t(".new_school_class"), new_school_class_path %>
</section>

<section>
  <h2><%= t(".my_tests") %></h2>
  <ul>
    <% @tests.each do |test| %>
      <li><%= link_to test.title, test_path(test) %></li>
    <% end %>
  </ul>
  <%= link_to t(".new_test"), new_test_path %>
</section>
